# {{ ansible_managed }}
#
# Audit rules generated by the ansible-role-devsecops 'monitor_paths' task.
# Managed paths:
{% for entry in _devsecops_monitor_validated_paths | default([]) %}
#   {{ entry.path }} ({{ 'directory tree' if entry.isdir else 'file' }}, perm={{ entry.access }}, key={{ entry.key }})
{% endfor %}
{% if devsecops_monitor_backlog_limit | int > 0 %}
# Kernel audit queue limit; the stock value is too small for syscall auditing.
-b {{ devsecops_monitor_backlog_limit | int }}
{% endif %}
{% for arch in devsecops_monitor_audit_arches %}
{% for entry in _devsecops_monitor_validated_paths | default([]) %}
# {{ entry.path }}: successful access ({{ arch }})
-a always,exit -F arch={{ arch }} -F {{ 'dir' if entry.isdir else 'path' }}={{ entry.path }} -F perm={{ entry.access }} -F success=1 -k {{ entry.key }}

# {{ entry.path }}: denied access ({{ arch }})
-a always,exit -F arch={{ arch }} -F {{ 'dir' if entry.isdir else 'path' }}={{ entry.path }} -S {{ devsecops_monitor_denied_syscalls | join(',') }} -F success=0 -k {{ entry.key }}
{% endfor %}
{% endfor %}
